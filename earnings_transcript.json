{
  "name": "earnings_transcript",
  "description": "Retrieve company earnings call transcripts.",
  "parameters": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string"
      },
      "quarter": {
        "type": "string",
        "enum": ["Q1", "Q2", "Q3", "Q4"]
      },
      "year": {
        "type": "integer"
      }
    },
    "required": ["ticker", "quarter", "year"]
  }
}