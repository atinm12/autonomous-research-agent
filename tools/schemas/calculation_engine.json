    "type": "object",
    "properties": {
      "calculation_type": {
        "type": "string",
        "enum": [
          "DCF",
          "growth_rate",
          "margin_analysis",
          "valuation_multiple",
          "statistical_analysis"
        ]
      },
      "inputs": {
        "type": "object",
        "description": "Financial inputs for calculation"
      }
    },
    "required": ["calculation_type", "inputs"]
  }
}