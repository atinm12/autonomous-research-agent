{
  "name": "sec_filing_search",
  "description": "Search and retrieve SEC EDGAR filings for a public company.",
  "parameters": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string",
        "description": "Stock ticker symbol"
      },
      "filing_type": {
        "type": "string",
        "enum": ["10-K", "10-Q", "8-K", "DEF 14A"],
        "description": "Type of SEC filing"
      },
      "year": {
        "type": "integer",
        "description": "Optional filing year"
      }
    },
    "required": ["ticker", "filing_type"]
  }
}