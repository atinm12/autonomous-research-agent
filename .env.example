# -------------------------------------------------------
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# -------------------------------------------------------

# LLM API
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic (if switching LLM backend)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Financial data (optional — yfinance used by default)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINANCIAL_MODELING_PREP_API_KEY=your_fmp_key_here

# Web / news search (optional — DuckDuckGo used by default)
TAVILY_API_KEY=your_tavily_key_here
NEWS_API_KEY=your_newsapi_key_here

# Vector database (optional — ChromaDB in-memory used by default)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# Agent behaviour
MAX_ITERATIONS=14
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=6000
